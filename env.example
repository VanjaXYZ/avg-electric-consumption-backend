POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
POSTGRES_DB=db_name

# JWT (required for the API to start; SecretKey must be at least 32 characters)
JWT_ISSUER=ElectricityPlanner
JWT_AUDIENCE=ElectricityPlanner
JWT_SECRET_KEY=replace-with-a-secret-key-at-least-32-chars
JWT_EXPIRY_MINUTES=60

# SMTP (optional — for POST /recommendation/email; use Mailtrap or your provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Electricity Planner
